<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console puro, net8.0 e não net8.0-windows: o Motor.cs não toca em Win32, e
       isso é uma propriedade que vale a pena manter verificada pelo compilador —
       no dia do backend Linux é este arquivo que atravessa inteiro. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Silabo</RootNamespace>
    <AssemblyName>silabo-teste</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Motor.cs" Link="Motor.cs" />
    <Compile Include="../Reconcilia.cs" Link="Reconcilia.cs" />
  </ItemGroup>
</Project>
